# Minecraft server address / port (the server ID is normally its hostname or IP)
MC_SERVER_HOST=Crowkey1.aternos.me
MC_SERVER_PORT=55764

# Bot account
MC_BOT_USERNAME=TestBot
MC_AUTH=offline

# Optional; leave empty to let Mineflayer detect the server version
MC_VERSION=

# Reconnect and cron health-check settings
RECONNECT_DELAY_MS=10000
HEALTHCHECK_TIMEOUT_MS=10000
